# Copy selected blocks to a .tf file and match every property to the live bridge.
# These IDs are examples; never apply them to create a replacement for import.
resource "hue_room" "bedroom" {
  name      = "Bedroom"
  archetype = "bedroom"
  children  = ["22222222-2222-4222-8222-222222222222"] # Device UUIDs.

  lifecycle {
    prevent_destroy = true
  }
}

resource "hue_scene" "reading" {
  name         = "Reading"
  group        = hue_room.bedroom.id
  speed        = 0.6
  auto_dynamic = false

  # Include every action from the existing scene, keyed by light UUID.
  # Images are unmanaged; metadata.image is never sent.
  actions = {
    "11111111-1111-4111-8111-111111111111" = {
      on         = true
      brightness = 100
      mirek      = 346
    }
  }

  lifecycle {
    prevent_destroy = true
  }
}
